{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-v3",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "pawanmishra.link",
      "custom_domain": true
    }
  ]
}
